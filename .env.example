# SkillLink Environment Variables Configuration
# Copy this file to .env.local and populate with your actual Supabase credentials

# Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Public Key (safe for client-side usage)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
